#usda 1.0
(
    upAxis = "Y"
)
# Points rprim: a 9x9 grid of spheres with per-point widths and colors.
def Camera "cam"
{
    double3 xformOp:translate = (0, 1.5, 9)
    float3 xformOp:rotateXYZ = (-10, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
def DistantLight "sun"
{
    float inputs:intensity = 50000
    float3 xformOp:rotateXYZ = (-50, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}
def Points "dots"
{
    point3f[] points = [(-2,0,0), (-1.5,0,0), (-1,0,0), (-0.5,0,0), (0,0,0), (0.5,0,0), (1,0,0), (1.5,0,0), (2,0,0),
                        (-2,0.5,0), (-1,0.5,0), (0,0.5,0), (1,0.5,0), (2,0.5,0),
                        (-2,1,0), (-1.5,1,0), (-1,1,0), (-0.5,1,0), (0,1,0), (0.5,1,0), (1,1,0), (1.5,1,0), (2,1,0),
                        (-2,1.5,0), (-1,1.5,0), (0,1.5,0), (1,1.5,0), (2,1.5,0),
                        (-2,2,0), (-1.5,2,0), (-1,2,0), (-0.5,2,0), (0,2,0), (0.5,2,0), (1,2,0), (1.5,2,0), (2,2,0)]
    float[] widths = [0.1, 0.15, 0.2, 0.25, 0.3, 0.25, 0.2, 0.15, 0.1,
                      0.3, 0.3, 0.3, 0.3, 0.3,
                      0.1, 0.15, 0.2, 0.25, 0.3, 0.25, 0.2, 0.15, 0.1,
                      0.3, 0.3, 0.3, 0.3, 0.3,
                      0.1, 0.15, 0.2, 0.25, 0.3, 0.25, 0.2, 0.15, 0.1] (interpolation = "vertex")
    color3f[] primvars:displayColor = [(1, 0.4, 0.2)] (interpolation = "constant")
}
def Plane "ground"
{
    uniform token axis = "Y"
    double width = 10
    double length = 10
    double3 xformOp:translate = (0, -0.3, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
