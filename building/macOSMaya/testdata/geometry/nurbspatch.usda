#usda 1.0
(
    upAxis = "Y"
)
# A bicubic NurbsPatch: hdMoonray has no rprim for it, so with scene-index
# imaging it renders only through HdMoonrayNurbsApproximatingSceneIndexPlugin.
def Camera "cam"
{
    double3 xformOp:translate = (0, 4, 7)
    float3 xformOp:rotateXYZ = (-30, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
def DistantLight "sun"
{
    float inputs:intensity = 50000
    float3 xformOp:rotateXYZ = (-50, 30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}
def NurbsPatch "patch"
{
    int uVertexCount = 4
    int vVertexCount = 4
    int uOrder = 4
    int vOrder = 4
    double[] uKnots = [0, 0, 0, 0, 1, 1, 1, 1]
    double[] vKnots = [0, 0, 0, 0, 1, 1, 1, 1]
    double2 uRange = (0, 1)
    double2 vRange = (0, 1)
    point3f[] points = [(-2,0,-2), (-0.7,0,-2), (0.7,0,-2), (2,0,-2),
                        (-2,0,-0.7), (-0.7,2,-0.7), (0.7,2,-0.7), (2,0,-0.7),
                        (-2,0,0.7), (-0.7,2,0.7), (0.7,2,0.7), (2,0,0.7),
                        (-2,0,2), (-0.7,0,2), (0.7,0,2), (2,0,2)]
    color3f[] primvars:displayColor = [(0.3, 0.7, 1)]
}
