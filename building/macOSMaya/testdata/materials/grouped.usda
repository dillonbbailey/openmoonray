#usda 1.0
(
    upAxis = "Y"
)
# material-editor-live-test.py: like a model imported from Maya, the geometry
# inside the Xform has its own material binding.
def Xform "statue"
{
    def Sphere "body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/Stone>
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
def Plane "ground"
{
    uniform token axis = "Y"
    double width = 12
    double length = 12
}
def SphereLight "light"
{
    float inputs:intensity = 60
    float inputs:radius = 0.3
    double3 xformOp:translate = (2, 3.5, 2)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Scope "Looks"
{
    def Material "Stone"
    {
        token outputs:moonray:surface.connect = </Looks/Stone/Base.outputs:surface>
        def Shader "Base"
        {
            uniform token info:id = "DwaBaseMaterial"
            color3f inputs:albedo = (0.6, 0.6, 0.6)
            token outputs:surface
        }
    }
}
