#usda 1.0
(
    upAxis = "Y"
)
def Camera "cam"
{
    double3 xformOp:translate = (0, 2.5, 9)
    float3 xformOp:rotateXYZ = (-12, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
def Sphere "ball"
{
    double3 xformOp:translate = (0, 1, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Plane "ground"
{
    uniform token axis = "Y"
    double width = 12
    double length = 12
}
def CylinderLight "light"
{
    float inputs:intensity = 40
    float inputs:radius = 0.15
    float inputs:length = 3
    double3 xformOp:translate = (0, 3.5, 1.5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
