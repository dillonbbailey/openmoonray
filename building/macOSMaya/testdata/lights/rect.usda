#usda 1.0
(
    upAxis = "Y"
)
def Camera "cam"
{
    double3 xformOp:translate = (0, 2.5, 9)
    float3 xformOp:rotateXYZ = (-12, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
def Sphere "ball"
{
    double3 xformOp:translate = (0, 1, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Plane "ground"
{
    uniform token axis = "Y"
    double width = 12
    double length = 12
}
def RectLight "light"
{
    float inputs:intensity = 40
    float inputs:width = 2
    float inputs:height = 2
    double3 xformOp:translate = (0, 4, 2)
    float3 xformOp:rotateXYZ = (-60, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
